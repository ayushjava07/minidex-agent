# ATOS — Pool and Report Schemas

type PoolState struct {
    contractAddress  String
    reserveA         String
    reserveB         String
    timestamp        Int
} representation map

type Report struct {
    agentId          String
    agentRole        String
    poolState        PoolState
    taskCid          &Task
    timestamp        Int
    summary          String
} representation map

type WorkflowState struct {
    workflowId       String
    step             String
    status           TaskStatus
    assignedAgent    String
    timestamp        Int
} representation map