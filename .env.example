# Required for Sepolia reads performed by monitor, report, liquidity, and analytics agents.
RPC_URL=https://sepolia.example.invalid/v3/replace-me

# Required only for scripts/addLiquidity.js and Sepolia deployments.
# Never commit a real value. Prefer a dedicated, minimally funded testnet account.
SEPOLIA_PRIVATE_KEY=replace-me

# Current MiniDEX deployment addresses.
TOKEN_A=0x0000000000000000000000000000000000000000
TOKEN_B=0x0000000000000000000000000000000000000000
DEX_ADDRESS=0x0000000000000000000000000000000000000000

# Optional amount used by scripts/addLiquidity.js.
LIQUIDITY_AMOUNT=1000

# Optional structured logging threshold: debug, info, warn, or error.
LOG_LEVEL=info

# Minimum connected peers required for /health/ready to return HTTP 200.
HEALTH_MIN_PEERS=1
# Bind health endpoints to this interface. Use 0.0.0.0 in containers.
HEALTH_HOST=127.0.0.1
HEALTH_CHECK_TIMEOUT_MS=2000

# Bounded exponential backoff for transient peer connection failures.
NETWORK_RETRY_ATTEMPTS=3
NETWORK_RETRY_DELAY_MS=200
NETWORK_RETRY_MAX_DELAY_MS=2000

# Maximum accepted agent message size before the stream is rejected.
NETWORK_MAX_MESSAGE_BYTES=65536
NETWORK_HANDLER_TIMEOUT_MS=5000
NETWORK_HANDLER_CONCURRENCY=4

# Required shared secret for authenticating agent-network envelopes.
# Generate a random value with at least 32 characters and distribute it securely.
NETWORK_AUTH_SECRET=replace-with-a-random-network-auth-secret
NETWORK_MAX_CLOCK_SKEW_MS=60000
NETWORK_REPLAY_TTL_MS=300000

# Per-sender and per-topic token bucket for authenticated inbound messages.
NETWORK_RATE_LIMIT_CAPACITY=120
NETWORK_RATE_LIMIT_REFILL_PER_SECOND=2
NETWORK_RATE_LIMIT_GLOBAL_CAPACITY=2400
NETWORK_RATE_LIMIT_GLOBAL_REFILL_PER_SECOND=40
NETWORK_RATE_LIMIT_SENDER_CAPACITY=480
NETWORK_RATE_LIMIT_SENDER_REFILL_PER_SECOND=8
NETWORK_RATE_LIMIT_IDLE_TTL_MS=300000
NETWORK_RATE_LIMIT_MAX_BUCKETS=10000

# Optional runtime locations for generated agent cryptographic material.
# Mount these paths from a secrets volume in production.
AGENT_KEYS_DIR=agents/keys
AGENT_PUBLIC_KEYS_FILE=agents/public-keys.json

# ─── Filecoin Storage Layer ───────────────────────────────────────────────────
# Storacha (w3up) is the primary upload backend. Set a valid UCAN token.
# STORACHA_TOKEN=replace-with-your-storacha-token
# STORACHA_SPACE=replace-with-your-space-did
# STORACHA_ENDPOINT=https://up.web3.storage

# Lotus RPC is optional for direct Filecoin deal proposals on top of Storacha.
# LOTUS_API_URL=https://lotus.example.invalid/rpc/v0
# LOTUS_API_TOKEN=replace-with-your-lotus-token

# Minimum Filecoin deal duration in epochs (518400 = ~180 days).
# DEAL_MIN_DURATION=518400
# DEAL_MIN_VERIFIED=true

# Upload constraints (100 MB default).
# FILECOIN_MAX_UPLOAD_SIZE=104857600
# FILECOIN_UPLOAD_TIMEOUT_MS=120000
# FILECOIN_RETRY_ATTEMPTS=3
# FILECOIN_RETRY_DELAY_MS=1000

# REST API for programmatic access from the frontend or agents.
# FILECOIN_API_PORT=4200
# FILECOIN_API_HOST=127.0.0.1
# FILECOIN_API_RATE_LIMIT_RPS=10
# FILECOIN_API_TOKEN=

# Observability.
# FILECOIN_METRICS_ENABLED=true
# FILECOIN_CACHE_DIR=./.filecoin-cache
