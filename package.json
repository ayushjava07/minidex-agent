    "test:unit": "vitest run --config tests/vitest.config.js",
    "test:coverage": "vitest run --config tests/vitest.config.js --coverage",
    "test:frontend": "npm test --prefix frontend",
    "check:secrets": "node scripts/checkSecrets.js",
    "test:network": "node scripts/testNetwork.js",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build --prefix frontend"
  },
